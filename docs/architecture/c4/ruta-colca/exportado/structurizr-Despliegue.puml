rectangle "Proveedor cloud\n<size:16>[Deployment Node: Región sa-east-1]</size>" <<DeploymentNode-RWxlbWVudA==>> as Produccion.Proveedorcloud {
  rectangle "==Balanceador de carga\n<size:16>[Infrastructure Node: Load balancer gestionado]</size>\n\nTermina TLS y reparte el tráfico HTTPS." <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Produccion.Proveedorcloud.Balanceadordecarga
  rectangle "VM Ubuntu 24.04 (x2)\n<size:16>[Deployment Node: Docker]</size>" <<DeploymentNode-RWxlbWVudA==>> as Produccion.Proveedorcloud.VMUbuntu2404 {
    rectangle "==API\n<size:16>[Container: Java 21, Spring Boot]</size>\n\nReglas de negocio de tours, reservas, pagos y sincronización. Monolito modular con arquitectura hexagonal (ADR-001)." <<Element-RWxlbWVudCxDb250YWluZXIsQUctMTA=>> as Produccion.Proveedorcloud.VMUbuntu2404.API_1
    rectangle "==Procesador de tareas\n<size:16>[Container: Java 21, Spring Boot (perfil worker, @Scheduled)]</size>\n\nReintenta los cobros pendientes con espera exponencial y envía las confirmaciones diferidas." <<Element-RWxlbWVudCxDb250YWluZXIsQUctMTA=>> as Produccion.Proveedorcloud.VMUbuntu2404.Procesadordetareas_1
  }

  rectangle "BD gestionada\n<size:16>[Deployment Node: PostgreSQL 16 (primaria + réplica)]</size>" <<DeploymentNode-RWxlbWVudA==>> as Produccion.Proveedorcloud.BDgestionada {
