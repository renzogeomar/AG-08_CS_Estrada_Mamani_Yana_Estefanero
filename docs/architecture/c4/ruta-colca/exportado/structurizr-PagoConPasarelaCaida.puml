@startuml
title <size:24>Dynamic View: RutaColca</size>\n<size:24>Escenario E2: la pasarela no responde al pagar y la reserva se confirma después.</size>

set separator none
top to bottom direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container,AG-10
  .Element-RWxlbWVudCxDb250YWluZXIsQUctMTA= {
    BackgroundColor: #0e7d73;
    LineColor: #e8892b;
    LineStyle: 0;
    LineThickness: 6;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database,AG-10
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2UsQUctMTA= {
    BackgroundColor: #0e7d73;
    LineColor: #e8892b;
    LineStyle: 0;
    LineThickness: 6;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Web
  .Element-RWxlbWVudCxDb250YWluZXIsV2Vi {
    BackgroundColor: #0e7d73;
    LineColor: #095750;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #0b3d62;
    LineColor: #072a44;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Externo
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw== {
    BackgroundColor: #8c8c8c;
    LineColor: #626262;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
  // RutaColca
  .Boundary-UnV0YUNvbGNh {
    BackgroundColor: #ffffff;
