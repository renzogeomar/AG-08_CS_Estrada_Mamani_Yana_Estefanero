person "==Turista\n<size:16>[Person]</size>\n\nVisitante nacional o extranjero que reserva tours al valle del Colca." <<Element-RWxlbWVudCxQZXJzb24=>> as Turista
person "==Operador de agencia\n<size:16>[Person]</size>\n\nPersonal de una agencia de Arequipa o Chivay que publica tours y gestiona reservas." <<Element-RWxlbWVudCxQZXJzb24=>> as Operadordeagencia
person "==Administrador de RutaColca\n<size:16>[Person]</size>\n\nAprueba agencias y revisa reportes de ventas." <<Element-RWxlbWVudCxQZXJzb24=>> as AdministradordeRutaColca
rectangle "==Pasarela de pagos\n<size:16>[Software System]</size>\n\nProcesa pagos con tarjeta y billetera móvil." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as Pasareladepagos
rectangle "==WhatsApp Business\n<size:16>[Software System]</size>\n\nMensajería para enviar itinerarios y confirmaciones." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as WhatsAppBusiness
rectangle "==Sistema de AUTOCOLCA\n<size:16>[Software System]</size>\n\nEmite y valida el boleto turístico del Colca (integración supuesta en el caso)." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as SistemadeAUTOCOLCA

rectangle "RutaColca\n<size:16>[Software System]</size>" <<Boundary-UnV0YUNvbGNh>> {
  rectangle "==Procesador de tareas\n<size:16>[Container: Java 21, Spring Boot (perfil worker, @Scheduled)]</size>\n\nReintenta los cobros pendientes con espera exponencial y envía las confirmaciones diferidas." <<Element-RWxlbWVudCxDb250YWluZXIsQUctMTA=>> as RutaColca.Procesadordetareas
  database "==Base de datos\n<size:16>[Container: PostgreSQL 16]</size>\n\nAgencias, tours, salidas, reservas, pagos y tareas pendientes (outbox)." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2UsQUctMTA=>> as RutaColca.Basededatos
  rectangle "==Web del turista\n<size:16>[Container: React (SPA)]</size>\n\nCatálogo de tours, reserva y pago." <<Element-RWxlbWVudCxDb250YWluZXIsV2Vi>> as RutaColca.Webdelturista
  rectangle "==Portal de agencias\n<size:16>[Container: React (PWA) + Service Worker]</size>\n\nPublica tours, registra reservas presenciales y asigna guías; funciona sin conexión." <<Element-RWxlbWVudCxDb250YWluZXIsV2Vi>> as RutaColca.Portaldeagencias
  rectangle "==API\n<size:16>[Container: Java 21, Spring Boot]</size>\n\nReglas de negocio de tours, reservas, pagos y sincronización. Monolito modular con arquitectura hexagonal (ADR-001)." <<Element-RWxlbWVudCxDb250YWluZXIsQUctMTA=>> as RutaColca.API
}

