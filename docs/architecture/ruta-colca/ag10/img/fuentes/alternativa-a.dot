digraph G { rankdir=LR; bgcolor=white; fontname="Arial"; pad=0.2; nodesep=0.45; ranksep=0.7; splines=true; nodesep=0.35; ranksep=0.5; node [fontname="Arial", fontsize=12]; edge [fontname="Arial", fontsize=10, color="#555555", fontcolor="#333333", style=dashed, arrowsize=0.8]; edge [style=solid, color="#444444"];
api [label=<<B>API</B><BR/><FONT POINT-SIZE="10">ReservarTour + timeout 5 s<BR/>+ circuit breaker</FONT>>, shape=box, style="rounded,filled", fillcolor="#E3EDF5", color="#7F7F7F", penwidth=1.2, margin="0.15,0.1"];
pas [label=<<B>Pasarela</B><BR/><FONT POINT-SIZE="10">externa</FONT>>, shape=box, style="rounded,filled", fillcolor="#EDEDED", color="#7F7F7F", penwidth=1.2, margin="0.15,0.1"];
bd [label=<<B>PostgreSQL</B><BR/><FONT POINT-SIZE="10">reserva PENDIENTE_PAGO<BR/>+ tarea (outbox)<BR/>misma transacción</FONT>>, shape=box, style="rounded,filled", fillcolor="#E3F1EA", color="#7F7F7F", penwidth=1.2, margin="0.15,0.1"];
wor [label=<<B>Procesador de tareas</B><BR/><FONT POINT-SIZE="10">@Scheduled cada 60 s<BR/>espera exponencial, tope 5 min</FONT>>, shape=box, style="rounded,filled", fillcolor="#FBEFD9", color="#BA750D", penwidth=2.5, margin="0.15,0.1"];
wha [label=<<B>WhatsApp</B>>, shape=box, style="rounded,filled", fillcolor="#EDEDED", color="#7F7F7F", penwidth=1.2, margin="0.15,0.1"];
api -> pas [label="1. cobra"]; api -> bd [label="2. si falla: guarda"]; wor -> bd [label="3. lee tareas"]; wor -> pas [label="4. reintenta\n(misma clave)"]; wor -> wha [label="5. confirma"];
{rank=same; pas; bd}
}